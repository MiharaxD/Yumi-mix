// Banco Postgres (Neon). Valores em centavos (Int).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Product {
  id                  String         @id @default(cuid())
  slug                String         @unique
  name                String
  description         String
  dimensions          String
  productionDays      Int
  readyToShip         Boolean        @default(false)
  videoUrl            String?
  // a venda acontece no marketplace: links dos anúncios
  shopeeUrl           String?
  mercadoLivreUrl     String?
  // preço de cada anúncio (centavos); a loja mais barata ganha o selo "Promoção"
  shopeePriceCents       Int?
  mercadoLivrePriceCents Int?
  position            Int            @default(0)
  // arquivado: some da loja, continua no admin e nos pedidos antigos
  archived            Boolean        @default(false)
  // frete embutido no preço (por unidade): abatido do frete real
  shippingCreditCents Int            @default(0)
  // pacote para cotação no Melhor Envio
  weightGrams         Int            @default(300)
  boxHeightCm         Int            @default(10)
  boxWidthCm          Int            @default(15)
  boxLengthCm         Int            @default(20)
  // arquivo da impressora (.3mf), só no admin; caminho relativo em ./uploads
  printFilePath       String?
  printFileName       String?
  printFileBytes      Int?
  createdAt           DateTime       @default(now())
  categoryId          String?
  category            Category?      @relation(fields: [categoryId], references: [id])
  images              ProductImage[]
  variants            Variant[]
}

model Category {
  id       String    @id @default(cuid())
  slug     String    @unique
  name     String
  position Int       @default(0)
  products Product[]
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String
  position  Int     @default(0)
}

model Variant {
  id         String      @id @default(cuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  name       String
  material   String
  colorHex   String
  imageUrl   String?
  priceCents Int
  position   Int         @default(0)
  orderItems OrderItem[]
}

model Order {
  id                  String      @id @default(cuid())
  number              Int         @unique
  // pendente | pago | em_producao | enviado | entregue | cancelado
  status              String      @default("pendente")
  customerName        String
  email               String
  whatsapp            String
  cep                 String
  street              String
  streetNumber        String
  complement          String      @default("")
  neighborhood        String      @default("")
  city                String
  uf                  String
  // sempre "entrega" (retirada foi removida; coluna mantida para pedidos antigos)
  deliveryMethod      String      @default("entrega")
  subtotalCents       Int
  // frete cobrado do cliente (já com o frete embutido abatido)
  shippingCents       Int
  // frete real cotado e serviço escolhido (interno)
  shippingRealCents   Int?
  shippingServiceId   String?
  shippingServiceName String?
  shippingDays        Int?
  trackingCode        String?
  shippedAt           DateTime?
  trackingEmailSentAt DateTime?
  totalCents          Int
  leadTimeDays        Int
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  paidAt              DateTime?
  items               OrderItem[]
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId      String?
  variant        Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  // referência ao produto (sem FK), para achar o arquivo 3D mesmo se a variante sumir
  productId      String?
  productName    String
  variantName    String
  unitPriceCents Int
  quantity       Int
}

model Notification {
  id        String   @id @default(cuid())
  // chave de idempotência, ex.: "pedido-pago:<orderId>"
  key       String   @unique
  message   String
  orderId   String?
  createdAt DateTime @default(now())
}

model CustomRequest {
  id               String               @id @default(cuid())
  number           Int                  @unique
  // nova | orcada | aprovada | recusada
  status           String               @default("nova")
  name             String
  contact          String
  description      String
  dimensions       String
  materialColor    String
  quantity         Int
  desiredDate      String
  quotedPriceCents Int?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  images           CustomRequestImage[]
}

model CustomRequestImage {
  id        String        @id @default(cuid())
  requestId String
  request   CustomRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  // caminho relativo dentro de ./uploads
  filePath  String
  mimeType  String
  sizeBytes Int
}

// Configuração da loja: uma linha só (id = 1).
model StoreSettings {
  id                         Int    @id @default(1)
  // CEP de onde saem os envios
  originCep                  String @default("")
  // frete grátis (opção mais barata) a partir deste subtotal; null desliga
  freeShippingThresholdCents Int?   @default(20000)
  // valor usado quando o Melhor Envio não está configurado ou falha
  fallbackShippingCents      Int    @default(2000)
  fallbackShippingDays       Int    @default(7)
}
