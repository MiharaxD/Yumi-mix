# Connection string do Postgres (Neon). Copie em vercel.com/mihara1/yumi-mix → Storage.
DATABASE_URL=
# Senha do painel /admin
ADMIN_PASSWORD=
# Segredo para assinar o cookie de sessão do admin (texto aleatório longo, mín. 32 caracteres)
ADMIN_SESSION_SECRET=

# Mercado Pago (Checkout Pro). Painel: mercadopago.com.br/developers/panel/app → app "Yumi Mix".
# Sem MP_ACCESS_TOKEN a loja usa o pagamento simulado (só no npm run dev).
# Access Token (APP_USR-...) da aba "Credenciais de teste" para testar; de produção para vender de verdade.
MP_ACCESS_TOKEN=
# Public Key (APP_USR-...). Hoje não é usada (Checkout Pro não precisa); guardada para Bricks no futuro.
MP_PUBLIC_KEY=
# Painel → app → Webhooks → "Assinatura secreta". Sem ela o webhook recusa tudo.
MP_WEBHOOK_SECRET=
# URL pública https da loja (ex.: https://yumi-mix.vercel.app). Vazio em dev local.
APP_URL=

# Melhor Envio (frete pelo CEP). Sem token, a loja usa o frete fixo de /admin/frete.
# Token em melhorenvio.com.br → Integrações → Permissões de acesso → Gerar token (escopo shipping-calculate).
MELHOR_ENVIO_TOKEN=
# "true" para usar o sandbox (sandbox.melhorenvio.com.br), com token gerado lá.
MELHOR_ENVIO_SANDBOX=
# Email de contato que vai no User-Agent (exigência do Melhor Envio).
MELHOR_ENVIO_CONTACT=

# Resend (email com o código de rastreio). Sem chave, o rastreio é salvo mas o email não sai.
RESEND_API_KEY=
# Remetente, de um domínio verificado no Resend (ex.: Yumi Mix <pedidos@seudominio.com.br>).
EMAIL_FROM=
